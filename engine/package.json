{
	"name": "@data-rover/engine",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^20.19 || >=22.12"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"bench": "node --expose-gc --disable-warning=ExperimentalWarning bench/run.ts",
		"xlsx-sample": "node --disable-warning=ExperimentalWarning scripts/xlsx-sample.ts",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"pyodide": "314.0.7",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"fflate": "0.8.3"
	}
}
