+/** Passes `inner`'s entries on, counting each. */
+function* counted<T>(inner: Iterator<T>, count: () => void): Generator<T, undefined, void> {
+	for (;;) {
+		const next = inner.next();
+		if (next.done === true) return;
+		count();
+		yield next.value;
+	}
+}
